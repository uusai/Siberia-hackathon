# Подключение к PostgreSQL. Приложение ходит в схему assistant, авторизация —
# в схему auth; search_path выставляется на уровне соединения (backend/app/db.py).
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Секрет для подписи JWT (HS256). Обязателен — значения по умолчанию в коде нет.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Yandex GPT (Foundation Models).
API_KEY=
FOLDER_ID=
MODEL_NAME=
API_URL=

# ---------------------------------------------------------------------------
# Необязательные настройки. Указаны значения по умолчанию — если переменную не
# задавать, применится именно оно.
# ---------------------------------------------------------------------------

# Вызов модели: таймаут одного запроса, число повторов при временных сбоях,
# пауза между повторами и температура генерации.
# Бюджет фронтенда — 90 с на весь /chat, а модель вызывается ДВАЖДЫ (генерация
# SQL и объяснение результата). Поднимая таймаут или повторы, поднимайте и
# REQUEST_TIMEOUT_MS во frontend/script.js, иначе браузер отвалится раньше.
# LLM_TIMEOUT_S=20
# LLM_RETRIES=1
# LLM_RETRY_PAUSE_S=1.5
# LLM_TEMPERATURE=0.6

# Пул соединений с БД и его таймауты. Кластер общий с другими командами
# (max_connections=100), схем две, поэтому пул небольшой.
# PG_POOL_MIN=3
# PG_POOL_MAX=6
# PG_CONNECT_TIMEOUT_S=10
# PG_POOL_WAIT_S=20
# PG_RETRIES=2
# PG_RETRY_PAUSE_S=0.5
# PG_MAX_LIFETIME_S=600

# Ограничение времени выполнения одного SQL-запроса, миллисекунды.
# SQL_STATEMENT_TIMEOUT_MS=5000

# Примечание: переменной AGENT_SYSTEM_PROMPT здесь больше нет. Системный
# промпт живёт в коде (backend/app/ai_agent.py) и собирается из живой схемы БД
# под конкретную роль — из окружения его подменить нельзя.
