# Что НЕ должно попадать в образ бэкенда.
#
# В Dockerfile стоит `COPY . .`, то есть без этого файла внутрь образа
# уезжает весь каталог backend целиком. Два пункта из него там не просто
# лишние, а недопустимые.

# ГЛАВНОЕ. Выгрузки базы содержат персональные данные: ФИО, паспорта,
# телефоны и почты студентов и абитуриентов. Образы копируются, выкладываются
# в реестры и раздаются — персональным данным внутри образа делать нечего.
backups/

# Снимки страниц и PDF приёмной комиссии: около 5 МБ, нужны только сборщику
# датасета на машине оператора. Выверенный результат разбора лежит в
# data/isu_official.json и в образ попадает.
data/raw/

# Байткод и мусор сборки
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Локальные настройки: переменные окружения приходят из env_file
# в docker-compose.yml, а не из файла внутри образа.
.env
