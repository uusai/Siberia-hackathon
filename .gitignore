.env
__pycache__/
*.pyc
.venv/
node_modules/
.cd
123.py
danya/
tests/
# Правило tests/ выше ловит и backend/tests/ — уже лежащие там файлы
# сохранились только потому, что попали в индекс раньше правила, а любой
# новый тест молча не добавлялся бы в репозиторий. Возвращаем каталог.
!backend/tests/
!backend/tests/**
# ...но не байткод: правило __pycache__/ выше отменяется предыдущей строкой.
backend/tests/__pycache__/
# Выгрузки БД: содержат ФИО, паспорта, телефоны и почты студентов.
backend/backups/
# Сырые снимки страниц isu.ru — вспомогательный материал сборщика источников,
# в репозитории не нужны. Выверенный датасет лежит в backend/data/*.json.
backend/data/raw/